@page
@model InvoiceApp.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-building-add"></i> Create your company</h4>

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Input.CompanyName" class="form-label"></label>
                        <input asp-for="Input.CompanyName" class="form-control" autocomplete="organization" />
                        <span asp-validation-for="Input.CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label">Services you need</legend>
                        <div class="form-check">
                            <input asp-for="Input.EnableInvoicing" class="form-check-input" />
                            <label asp-for="Input.EnableInvoicing" class="form-check-label"></label>
                        </div>
                        <div class="form-check">
                            <input asp-for="Input.EnableRentTracking" class="form-check-input" />
                            <label asp-for="Input.EnableRentTracking" class="form-check-label"></label>
                        </div>
                        <div class="form-text">You can change these any time in Settings.</div>
                    </fieldset>

                    <button type="submit" class="btn btn-primary w-100">Register</button>
                </form>

                <p class="text-center mt-3 mb-0 small">
                    Already registered? <a href="/Account/Login">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
