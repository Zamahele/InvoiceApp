@page
@model InvoiceApp.Web.Pages.Invoices.CreateModel
@{
    ViewData["Title"] = Model.IsEditing ? "Edit Invoice" : "New Invoice";

    // Unit options come from the rate library (Model.Units, sourced from SavedRates in the DB).
    var units = Model.Units;
    var hasLineItems = Model.Items.Any(item => !string.IsNullOrWhiteSpace(item.Description)
        || item.Quantity.GetValueOrDefault() != 0
        || item.Rate.GetValueOrDefault() != 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">@(Model.IsEditing ? "Edit Invoice" : "New Invoice")</h5>
    <a href="@(Model.IsEditing ? $"/Invoices/Preview?id={Model.Invoice.Id}" : "/")" class="btn btn-sm btn-outline-secondary" aria-label="Back">
        <i class="bi bi-arrow-left"></i>
    </a>
</div>

@if (Model.Company == null || string.IsNullOrEmpty(Model.Company.Name))
{
    <div class="alert alert-warning py-2">
        <i class="bi bi-exclamation-triangle"></i>
        Company details not set. <a href="/Settings">Set up now</a>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 mb-3">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" id="invoiceForm" class="needs-validation" novalidate>
    <input asp-for="Invoice.Id" type="hidden" />

    <!-- Invoice Meta -->
    <div class="card mb-3">
        <div class="card-header fw-semibold">Invoice Details</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label">Invoice No</label>
                    <input asp-for="Invoice.InvoiceNumber" class="form-control"
                           value="@(Model.IsEditing ? Model.Invoice.InvoiceNumber : Model.NextInvoiceNumber)" required />
                    <div class="invalid-feedback">Invoice number is required.</div>
                </div>
                <div class="col-6">
                    <label class="form-label">Invoice Date</label>
                    <input asp-for="Invoice.InvoiceDate" type="date" class="form-control" required />
                    <div class="invalid-feedback">Invoice date is required.</div>
                </div>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-12">
                    <label class="form-label">Category <span class="text-muted small">(optional)</span></label>
                    <select asp-for="Invoice.Category" class="form-select">
                        <option value="General">General</option>
                        <option value="Maintenance">Maintenance</option>
                        <option value="Hosting">Hosting</option>
                        <option value="Development">Development</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="form-check">
                <input asp-for="Invoice.IsReissue" class="form-check-input" type="checkbox"
                       id="reissueCheck" onchange="toggleReissue(this)" />
                <label class="form-check-label" for="reissueCheck">Re-issue Invoice</label>
            </div>
            <div id="reissueSection" class="mt-2 @(Model.Invoice.IsReissue ? "" : "d-none")">
                <label class="form-label">Re-issue Date</label>
                <input asp-for="Invoice.ReissueDate" type="date" class="form-control" />
            </div>
        </div>
    </div>

    <!-- Bill To -->
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-person"></i> Bill To</div>
        <div class="card-body">
            <div class="mb-2">
                <input asp-for="Invoice.ClientName" class="form-control" placeholder="Client / Company Name" required />
                <div class="invalid-feedback">Client name is required.</div>
            </div>
            <div class="mb-2">
                <input asp-for="Invoice.ClientEmail" type="email" class="form-control" placeholder="Client email (for sending the invoice)" />
            </div>
            <div class="mb-2">
                <input asp-for="Invoice.ClientAddressLine1" class="form-control" placeholder="Address Line 1" />
            </div>
            <div class="mb-2">
                <input asp-for="Invoice.ClientAddressLine2" class="form-control" placeholder="Address Line 2 (optional)" />
            </div>
            <div class="row g-2">
                <div class="col-8">
                    <input asp-for="Invoice.ClientCity" class="form-control" placeholder="City" />
                </div>
                <div class="col-4">
                    <input asp-for="Invoice.ClientPostalCode" class="form-control" placeholder="Code" />
                </div>
            </div>
        </div>
    </div>

    <!-- Line Items -->
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-list-ul"></i> Line Items</div>
        <div class="card-body p-2">

            @if (Model.SavedRates.Any())
            {
                <div class="mb-2">
                    <label class="form-label small mb-1">Add a saved item</label>
                    <select id="savedRatePicker" class="form-select">
                        <option value="">Choose a saved item…</option>
                        @foreach (var r in Model.SavedRates)
                        {
                            <option value="@r.Description" data-unit="@r.Unit" data-rate="@(r.Rate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">
                                @r.Description — R@(r.Rate.ToString("0.00")) / @r.Unit
                            </option>
                        }
                    </select>
                </div>
                <hr class="my-2" />
            }

            <div id="lineItems">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.Items[i].Description)
                        || Model.Items[i].Quantity.GetValueOrDefault() != 0
                        || Model.Items[i].Rate.GetValueOrDefault() != 0)
                    {
                        var quantityValue = Model.Items[i].Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                        var rateValue = Model.Items[i].Rate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                        <article class="invoice-item-row">
                            <input type="hidden" name="Items[@i].Description" data-field="Description" value="@Model.Items[i].Description" />
                            <input type="hidden" name="Items[@i].Unit" data-field="Unit" value="@Model.Items[i].Unit" />
                            <input type="hidden" name="Items[@i].Quantity" data-field="Quantity" value="@quantityValue" />
                            <input type="hidden" name="Items[@i].Rate" data-field="Rate" value="@rateValue" />
                            <div class="invoice-item-main">
                                <span class="invoice-item-number">@(i + 1)</span>
                                <div class="invoice-item-description">
                                    <strong class="item-description">@Model.Items[i].Description</strong>
                                    <span class="item-meta">@quantityValue @Model.Items[i].Unit × R @Model.Items[i].Rate?.ToString("N2")</span>
                                </div>
                                <strong class="item-amount">R @((Model.Items[i].Quantity.GetValueOrDefault() * Model.Items[i].Rate.GetValueOrDefault()).ToString("N2"))</strong>
                            </div>
                            <div class="invoice-item-actions">
                                <button type="button" class="btn btn-outline-primary item-edit" title="Edit line" aria-label="Edit line">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger item-remove" title="Remove line" aria-label="Remove line">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>

            <div id="itemEditor" class="invoice-item-editor @(hasLineItems ? "d-none" : "")">
                <div class="line-item-heading">
                    <strong id="itemEditorTitle">New line item</strong>
                    <button type="button" class="btn btn-outline-secondary" id="closeItemEditor" title="Close editor" aria-label="Close editor">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="editorDescription">Description</label>
                    <input id="editorDescription" class="form-control" placeholder="e.g. Monthly hosting" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label small mb-1" for="editorUnit">Unit</label>
                        <select id="editorUnit" class="form-select">
                            @foreach (var unit in units)
                            {
                                <option value="@unit">@unit</option>
                            }
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="editorQuantity">Qty</label>
                        <input id="editorQuantity" type="number" step="0.001" min="0.001" class="form-control" inputmode="decimal" placeholder="1" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="editorRate">Rate (R)</label>
                        <input id="editorRate" type="number" step="0.01" min="0" class="form-control" inputmode="decimal" placeholder="0.00" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Line total</span>
                    <strong id="editorAmount" class="text-primary">R 0.00</strong>
                </div>
                <div id="editorError" class="text-danger small mt-2 d-none" role="alert"></div>
                <button type="button" id="saveItem" class="btn btn-primary w-100 mt-3">
                    <i class="bi bi-check-lg"></i> <span>Add line item</span>
                </button>
            </button>
            <button type="button" class="btn btn-primary item-add-trigger @(hasLineItems ? "" : "d-none")" id="addBlankRow" title="Add line item" aria-label="Add line item">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            </button>

            <div class="d-flex justify-content-between align-items-center mt-3 px-1">
                <span class="text-muted small">Items total (excl. VAT)</span>
                <span class="fw-bold" id="liTotal">R 0.00</span>
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label">Notes (optional)</label>
            <textarea asp-for="Invoice.Notes" class="form-control" rows="2"
                      placeholder="Any additional notes..."></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-4 d-none d-md-block">
        <i class="bi bi-@(Model.IsEditing ? "check-lg" : "eye")"></i> @(Model.IsEditing ? "Save Changes" : "Preview Invoice")
    </button>

    <div class="invoice-mobile-submit d-md-none">
        <div class="invoice-mobile-total">
            <span>Items subtotal</span>
            <strong id="mobileLiTotal">R 0.00</strong>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-@(Model.IsEditing ? "check-lg" : "eye")"></i>
            @(Model.IsEditing ? "Save Changes" : "Preview Invoice")
        </button>
    </div>

</form>

@section Scripts {
    <script>
        function toggleReissue(cb) {
            document.getElementById('reissueSection').classList.toggle('d-none', !cb.checked);
        }

        (function () {
            const container = document.getElementById('lineItems');
            const picker = document.getElementById('savedRatePicker');
            const editor = document.getElementById('itemEditor');
            const editorTitle = document.getElementById('itemEditorTitle');
            const editorDescription = document.getElementById('editorDescription');
            const editorUnit = document.getElementById('editorUnit');
            const editorQuantity = document.getElementById('editorQuantity');
            const editorRate = document.getElementById('editorRate');
            const editorAmount = document.getElementById('editorAmount');
            const editorError = document.getElementById('editorError');
            const saveItemButton = document.getElementById('saveItem');
            const addButton = document.getElementById('addBlankRow');
            let editingRow = null;

            // Model binding needs Items[0..n] with no gaps; renumber after every add/remove.
            function reindex() {
                container.querySelectorAll('.invoice-item-row').forEach((row, i) => {
                    row.querySelectorAll('[data-field]').forEach(input => {
                        input.name = 'Items[' + i + '].' + input.dataset.field;
                    });
                    row.querySelector('.invoice-item-number').textContent = i + 1;
                });
            }

            function recalc() {
                let total = 0;
                container.querySelectorAll('.invoice-item-row').forEach(row => {
                    const quantity = parseFloat(row.querySelector('[data-field="Quantity"]').value) || 0;
                    const rate = parseFloat(row.querySelector('[data-field="Rate"]').value) || 0;
                    const amount = quantity * rate;
                    row.querySelector('.item-amount').textContent = 'R ' + amount.toFixed(2);
                    total += amount;
                });
                document.getElementById('liTotal').textContent = 'R ' + total.toFixed(2);
                const mobileTotal = document.getElementById('mobileLiTotal');
                if (mobileTotal) mobileTotal.textContent = 'R ' + total.toFixed(2);
            }

            function updateEditorAmount() {
                const quantity = parseFloat(editorQuantity.value) || 0;
                const rate = parseFloat(editorRate.value) || 0;
                editorAmount.textContent = 'R ' + (quantity * rate).toFixed(2);
            }

            function showEditor(visible) {
                editor.classList.toggle('d-none', !visible);
                addButton.classList.toggle('d-none', visible);
                if (visible) {
                    editorDescription.focus();
                    editor.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }

            function resetEditor() {
                editingRow = null;
                editorTitle.textContent = 'New line item';
                saveItemButton.querySelector('span').textContent = 'Add line item';
                editorDescription.value = '';
                editorUnit.selectedIndex = 0;
                editorQuantity.value = '';
                editorRate.value = '';
                editorError.textContent = '';
                editorError.classList.add('d-none');
                updateEditorAmount();
            }

            function createHiddenField(field, value) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.dataset.field = field;
                input.value = value;
                return input;
            }

            function createRow(values) {
                const row = document.createElement('article');
                row.className = 'invoice-item-row';
                row.append(
                    createHiddenField('Description', values.description),
                    createHiddenField('Unit', values.unit),
                    createHiddenField('Quantity', values.quantity),
                    createHiddenField('Rate', values.rate));

                const main = document.createElement('div');
                main.className = 'invoice-item-main';
                const number = document.createElement('span');
                number.className = 'invoice-item-number';
                const description = document.createElement('div');
                description.className = 'invoice-item-description';
                const descriptionText = document.createElement('strong');
                descriptionText.className = 'item-description';
                const meta = document.createElement('span');
                meta.className = 'item-meta';
                const amount = document.createElement('strong');
                amount.className = 'item-amount';
                description.append(descriptionText, meta);
                main.append(number, description, amount);

                const actions = document.createElement('div');
                actions.className = 'invoice-item-actions';
                const edit = document.createElement('button');
                edit.type = 'button';
                edit.className = 'btn btn-outline-primary item-edit';
                edit.title = 'Edit line';
                edit.setAttribute('aria-label', 'Edit line');
                edit.innerHTML = '<i class="bi bi-pencil"></i>';
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'btn btn-outline-danger item-remove';
                remove.title = 'Remove line';
                remove.setAttribute('aria-label', 'Remove line');
                remove.innerHTML = '<i class="bi bi-trash"></i>';
                actions.append(edit, remove);
                row.append(main, actions);
                renderRow(row, values);
                wireRow(row);
                return row;
            }

            function getRowValues(row) {
                return {
                    description: row.querySelector('[data-field="Description"]').value,
                    unit: row.querySelector('[data-field="Unit"]').value,
                    quantity: row.querySelector('[data-field="Quantity"]').value,
                    rate: row.querySelector('[data-field="Rate"]').value
                };
            }

            function renderRow(row, values) {
                row.querySelector('[data-field="Description"]').value = values.description;
                row.querySelector('[data-field="Unit"]').value = values.unit;
                row.querySelector('[data-field="Quantity"]').value = values.quantity;
                row.querySelector('[data-field="Rate"]').value = values.rate;
                row.querySelector('.item-description').textContent = values.description;
                row.querySelector('.item-meta').textContent = values.quantity + ' ' + values.unit + ' × R ' + Number(values.rate).toFixed(2);
                row.querySelector('.item-amount').textContent = 'R ' + (Number(values.quantity) * Number(values.rate)).toFixed(2);
            }

            function wireRow(row) {
                row.querySelector('.item-edit').addEventListener('click', () => {
                    editingRow = row;
                    const values = getRowValues(row);
                    editorTitle.textContent = 'Edit line item';
                    saveItemButton.querySelector('span').textContent = 'Update line item';
                    editorDescription.value = values.description;
                    editorUnit.value = values.unit;
                    editorQuantity.value = values.quantity;
                    editorRate.value = values.rate;
                    editorError.classList.add('d-none');
                    updateEditorAmount();
                    showEditor(true);
                });

                row.querySelector('.item-remove').addEventListener('click', () => {
                    row.remove();
                    reindex();
                    recalc();
                });
            }

            function addRow(values) {
                const row = createRow(values);
                container.appendChild(row);
                reindex();
                recalc();
            }

            function saveEditorItem() {
                const values = {
                    description: editorDescription.value.trim(),
                    unit: editorUnit.value,
                    quantity: editorQuantity.value,
                    rate: editorRate.value
                };
                const quantity = Number(values.quantity);
                const rate = Number(values.rate);
                if (!values.description || !values.quantity || !Number.isFinite(quantity) || quantity <= 0 || values.rate === '' || !Number.isFinite(rate) || rate < 0) {
                    editorError.textContent = 'Enter a description, quantity greater than zero, and a valid rate.';
                    editorError.classList.remove('d-none');
                    return;
                }

                if (editingRow) {
                    renderRow(editingRow, values);
                } else {
                    container.appendChild(createRow(values));
                }

                reindex();
                recalc();
                resetEditor();
                showEditor(false);
            }

            container.querySelectorAll('.invoice-item-row').forEach(wireRow);
            reindex();
            recalc();

            addButton.addEventListener('click', () => {
                resetEditor();
                showEditor(true);
            });
            document.getElementById('closeItemEditor').addEventListener('click', () => {
                resetEditor();
                showEditor(false);
            });
            saveItemButton.addEventListener('click', saveEditorItem);
            editorQuantity.addEventListener('input', updateEditorAmount);
            editorRate.addEventListener('input', updateEditorAmount);

            if (picker) {
                picker.addEventListener('change', () => {
                    const opt = picker.selectedOptions[0];
                    if (!opt || !opt.value) return;
                    addRow({ description: opt.value, unit: opt.dataset.unit, rate: opt.dataset.rate, quantity: '1' });
                    picker.value = '';
                    if (!editor.classList.contains('d-none')) {
                        resetEditor();
                        showEditor(false);
                    }
                });
            }
        })();
    </script>
}
