@page
@model InvoiceApp.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-box-arrow-in-right"></i> Sign in</h4>

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <div class="login-divider"><span>or</span></div>
                <button type="button" id="passkeySignIn" class="btn btn-outline-primary w-100">
                    <i class="bi bi-fingerprint"></i> Sign in with a passkey
                </button>
                <div id="passkeyMessage" class="small text-center mt-2" role="status" aria-live="polite"></div>

                <p class="text-center mt-3 mb-0 small">
                    New here? <a href="/Account/Register">Create a company</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkeys.js" asp-append-version="true"></script>
    <script>
        (function () {
            var button = document.getElementById('passkeySignIn');
            var message = document.getElementById('passkeyMessage');
            var email = document.getElementById('Input_Email');

            if (!window.PublicKeyCredential) {
                button.disabled = true;
                message.textContent = 'Passkeys are not supported by this browser.';
                return;
            }
            if (!window.isSecureContext && location.hostname !== 'localhost') {
                button.disabled = true;
                message.textContent = 'Passkeys require a secure HTTPS connection.';
                return;
            }

            button.addEventListener('click', async function () {
                button.disabled = true;
                message.textContent = 'Waiting for your passkey...';
                try {
                    var form = new URLSearchParams();
                    form.set('email', email.value.trim());
                    var options = await PasskeyClient.post('?handler=PasskeyOptions', form, false);
                    var credential = await navigator.credentials.get({ publicKey: PasskeyClient.requestOptions(options) });
                    var returnUrl = new URLSearchParams(location.search).get('ReturnUrl');
                    var finishUrl = '?handler=PasskeyLogin' + (returnUrl ? '&returnUrl=' + encodeURIComponent(returnUrl) : '');
                    var result = await PasskeyClient.post(finishUrl, PasskeyClient.serializeCredential(credential), true);
                    location.assign(result.redirectUrl);
                } catch (error) {
                    message.textContent = error.name === 'NotAllowedError'
                        ? 'Passkey sign-in was cancelled or unavailable.'
                        : error.message || 'Passkey sign-in failed.';
                    button.disabled = false;
                }
            });
        })();
    </script>
}
